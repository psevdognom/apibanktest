# =========================
# Django
# =========================
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=*

# =========================
# Database (PostgreSQL)
# =========================
POSTGRES_DB=simplebank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@db:5432/simplebank

# =========================
# JWT (SimpleJWT)
# =========================
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=1

# =========================
# Business logic
# =========================
WELCOME_BONUS=10000.00
TRANSFER_FEE_PERCENT=0.025
TRANSFER_FEE_MIN=5.00

CORS_ALLOW_ALL_ORIGINS=True

# =========================
# OpenAPI / Swagger
# =========================
API_TITLE=SimpleBank API
API_VERSION=1.0.0
API_DESCRIPTION=Bank API with accounts, transactions and transfers